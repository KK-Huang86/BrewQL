# Copy to .env and fill in. Never commit .env.

# Postgres owner (used only by docker init scripts, never by the API)
POSTGRES_USER=genbi_owner
POSTGRES_PASSWORD=change-me

# Read-only role used by the API
GENBI_READER_PASSWORD=change-me-too

# Append-only role the API uses to write the audit trail (record-audit-log); different from the others
GENBI_AUDIT_WRITER_PASSWORD=change-me-three
# Key for the visitor ID (HMAC of the source IP), at least 32 characters: openssl rand -hex 32.
# Changing it starts new visitor IDs; old records keep the old ones.
AUDIT_IP_HMAC_KEY=

# Role the knowledge importer uses to write the RAG knowledge base (rag-knowledge-base); different from the others
GENBI_KNOWLEDGE_WRITER_PASSWORD=change-me-four

# Host port for Postgres (bound to 127.0.0.1). 5434, not 5432: other projects' Postgres often use 5432.
DB_PORT=5434

# Bedrock (local dev uses ~/.aws; set AWS_PROFILE to a profile with bedrock:InvokeModel)
AWS_REGION=us-east-1
# Use the BrewQL runtime profile; `default` may belong to another project.
AWS_PROFILE=brewql
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
# Leave empty for models without the effort parameter (e.g. Haiku 4.5)
BEDROCK_EFFORT=low
# Input guardrail from `terraform -chdir=infra/terraform output`; leave empty to skip (local dev only).
# The IAM user also needs bedrock:ApplyGuardrail (see output apply_guardrail_policy_json).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Self-correction: extra model calls after a failed SQL attempt (0-5, default 1).
# MAX_SQL_RETRIES=1
# Questions the whole site answers per Taipei day (positive integer, default 500, about $2/day).
# DAILY_QUESTION_LIMIT=500

# Backend or eval run outside compose (uv run uvicorn ..., python -m evaluation) read this file too.
# Compose builds DATABASE_URL itself from GENBI_READER_PASSWORD and ignores these lines.
# Connect as genbi_reader on DB_PORT; the eval refuses anything else before connecting.
# DATABASE_URL=postgresql://genbi_reader:change-me-too@127.0.0.1:5434/genbi
# AUDIT_DATABASE_URL=postgresql://genbi_audit_writer:change-me-three@127.0.0.1:5434/genbi
# KNOWLEDGE_DATABASE_URL=postgresql://genbi_knowledge_writer:change-me-four@127.0.0.1:5434/genbi
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# How the model learns the schema: static (full text, the evaluation baseline) or rag (retrieved
# knowledge; run the knowledge-import first). Stays static until the evaluation favours rag.
# PROMPT_MODE=static
# CORS_ORIGINS=["http://localhost:5173"]

# Public traffic limits enforced by nginx, per source IP (defaults shown).
# ASK_RATE_PER_MINUTE=10
# ASK_RATE_BURST=5
# MAX_CONNECTIONS_PER_IP=20

# Grafana Cloud for `docker compose --profile observability` (observe-with-grafana D11).
# Token: access policy with metrics:write and logs:write only. Leave empty to run without Alloy.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
# local or demo: tells the two apart in the shared stack (default local).
# BREWQL_ENV=local
