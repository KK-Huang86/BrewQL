# Copy to .env and fill in. Never commit .env.

# Postgres owner (used only by docker init scripts, never by the API)
POSTGRES_USER=genbi_owner
POSTGRES_PASSWORD=change-me

# Read-only role used by the API
GENBI_READER_PASSWORD=change-me-too

# Host port for Postgres (bound to 127.0.0.1)
DB_PORT=5432

# Bedrock (local dev uses ~/.aws; set AWS_PROFILE to a profile with bedrock:InvokeModel)
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
# Leave empty for models without the effort parameter (e.g. Haiku 4.5)
BEDROCK_EFFORT=low
# Input guardrail from `terraform -chdir=infra/terraform output`; leave empty to skip (local dev only).
# The IAM user also needs bedrock:ApplyGuardrail (see output apply_guardrail_policy_json).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Self-correction: extra model calls after a failed SQL attempt (0-5, default 1).
# MAX_SQL_RETRIES=1

# Backend or eval run outside compose (uv run uvicorn ..., python -m evaluation) read this file too.
# Compose builds DATABASE_URL itself from GENBI_READER_PASSWORD and ignores these lines.
# The port must match DB_PORT above (compose publishes the db on it), not always 5432.
# DATABASE_URL=postgresql://genbi_reader:change-me-too@127.0.0.1:5432/genbi
# CORS_ORIGINS=["http://localhost:5173"]
