server {
    listen 80;
    root /usr/share/nginx/html;

    # Whitelist (limit-public-traffic D6): only the APIs listed here reach the backend. A new
    # endpoint stays private until it gets its own location; everything else under /api/ is 404.
    # UI and API share one origin, so the browser needs no CORS in deployment.
    location = /api/ask {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location /api/ {
        return 404;
    }

    # Backend-internal paths must not fall through to the SPA (which would answer 200).
    location ~ ^/(metrics|health|docs|openapi\.json)(/|$) {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
