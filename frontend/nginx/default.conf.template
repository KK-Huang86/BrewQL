# Rate limits per source IP (limit-public-traffic D1, D8). The ${...} values come from the
# environment when the official image renders this template; defaults live in the Dockerfile.
# A bad value (0, text, empty) makes nginx refuse to start rather than run without a limit.
limit_req_zone $binary_remote_addr zone=ask:10m rate=${ASK_RATE_PER_MINUTE}r/m;
limit_conn_zone $binary_remote_addr zone=per_ip:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80;
    root /usr/share/nginx/html;

    limit_conn per_ip ${MAX_CONNECTIONS_PER_IP};
    # A question is at most 1000 characters, so 16 KB of JSON is plenty; slow or stalled
    # clients are dropped after 10 s instead of holding a worker (design D5).
    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    # Same shape as a normal answer so the UI shows the message (design D2).
    error_page 429 = @too_many_requests;

    # Whitelist (limit-public-traffic D6): only the APIs listed here reach the backend. A new
    # endpoint stays private until it gets its own location; everything else under /api/ is 404.
    # UI and API share one origin, so the browser needs no CORS in deployment.
    location = /api/ask {
        # nodelay: the burst goes through at once; anything beyond is 429, never queued.
        limit_req zone=ask burst=${ASK_RATE_BURST} nodelay;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location /api/ {
        return 404;
    }

    # Backend-internal paths must not fall through to the SPA (which would answer 200).
    location ~ ^/(metrics|health|docs|openapi\.json)(/|$) {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }

    location @too_many_requests {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"status":"error","sql":null,"columns":[],"rows":[],"message":"請求太頻繁，請稍後再試","error_kind":null,"refusal_source":null}';
    }
}
