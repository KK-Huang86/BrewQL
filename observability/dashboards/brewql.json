{
  "title": "BrewQL",
  "uid": "brewql-overview",
  "description": "BrewQL 營運總覽（observe-with-grafana）。由 repo 的 observability/dashboards/brewql.json 匯入。",
  "tags": [
    "brewql"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prom",
        "label": "Prometheus",
        "query": "prometheus",
        "regex": ".*-prom$"
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "regex": ".*-logs$"
      },
      {
        "type": "query",
        "name": "env",
        "label": "環境",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(up{project=\"brewql\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{project=\"brewql\"}, env)",
        "refresh": 2,
        "current": {
          "text": "local",
          "value": "local"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "總覽（所選時間範圍）",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "提問數",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(brewql_ask_total{project=\"brewql\", env=\"$env\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "成功率",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(brewql_ask_total{project=\"brewql\", env=\"$env\", status=\"ok\"}[$__range])) / sum(increase(brewql_ask_total{project=\"brewql\", env=\"$env\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "p95 總耗時",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(brewql_ask_seconds_bucket{project=\"brewql\", env=\"$env\"}[$__range])))",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "估算成本",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(brewql_estimated_cost_usd_total{project=\"brewql\", env=\"$env\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "依 backend/app/pricing.py 單價估算；實際金額以 AWS Cost Explorer 為準"
    },
    {
      "type": "stat",
      "title": "成本不完整的題數",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(brewql_unpriced_questions_total{project=\"brewql\", env=\"$env\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "模型不在單價表或 Guardrail 沒回報用量；大於 0 代表估算成本偏低，該更新單價表"
    },
    {
      "type": "gauge",
      "title": "今日額度",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "brewql_daily_questions_used{project=\"brewql\", env=\"$env\"} / brewql_daily_question_limit{project=\"brewql\", env=\"$env\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "台北時間午夜歸零"
    },
    {
      "type": "row",
      "title": "結果分布",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "每分鐘提問（依結果）",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(brewql_ask_total{project=\"brewql\", env=\"$env\"}[$__rate_interval])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "拒答來源",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (refusal_source) (increase(brewql_ask_total{project=\"brewql\", env=\"$env\", status=\"refused\"}[$__rate_interval]))",
          "legendFormat": "{{refusal_source}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "錯誤種類",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (error_kind) (increase(brewql_ask_total{project=\"brewql\", env=\"$env\", status=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{error_kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "unavailable_* 是 5xx（Guardrail、Bedrock、資料庫無法使用）；generation、guardrail、query 是答題過程的失敗"
    },
    {
      "type": "row",
      "title": "耗時",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "總耗時 p50 / p95",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(brewql_ask_seconds_bucket{project=\"brewql\", env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(brewql_ask_seconds_bucket{project=\"brewql\", env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "各階段 p95",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(brewql_stage_seconds_bucket{project=\"brewql\", env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "重試時 model 與 db 每次呼叫各算一次"
    },
    {
      "type": "row",
      "title": "成本與 Guardrail",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "每小時 token（依模型、方向）",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (model, direction) (increase(brewql_llm_tokens_total{project=\"brewql\", env=\"$env\"}[1h]))",
          "legendFormat": "{{direction}} {{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "每日估算成本",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (component) (increase(brewql_estimated_cost_usd_total{project=\"brewql\", env=\"$env\"}[1d]))",
          "legendFormat": "{{component}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Guardrail 攔截原因",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(brewql_guardrail_blocks_total{project=\"brewql\", env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "公開流量（nginx access log）",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "429 與 404（每 5 分鐘）",
      "id": 20,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({project=\"brewql\", env=\"$env\", service=\"frontend\"} | json | __error__=\"\" | status=~\"429|404\" [5m]))",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "429 是 nginx 每 IP 限流；404 是白名單外的路徑（掃描或打內部端點）"
    },
    {
      "type": "table",
      "title": "被限流最多的來源 IP",
      "id": 21,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "topk(10, sum by (remote_addr) (count_over_time({project=\"brewql\", env=\"$env\", service=\"frontend\"} | json | __error__=\"\" | status=\"429\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{remote_addr}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "主機與容器資源",
      "id": 22,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "主機 CPU 使用率",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{project=\"brewql\", env=\"$env\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "cpu",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "主機記憶體使用率",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 42
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes{project=\"brewql\", env=\"$env\"} / node_memory_MemTotal_bytes{project=\"brewql\", env=\"$env\"}",
          "legendFormat": "memory",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "主機檔案系統使用率",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "expr": "1 - node_filesystem_avail_bytes{project=\"brewql\", env=\"$env\"} / node_filesystem_size_bytes{project=\"brewql\", env=\"$env\"}",
          "legendFormat": "{{mountpoint}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "主機負載",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 42
      },
      "targets": [
        {
          "expr": "node_load1{project=\"brewql\", env=\"$env\"}",
          "legendFormat": "load1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "expr": "node_load5{project=\"brewql\", env=\"$env\"}",
          "legendFormat": "load5",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "容器 CPU（核數）",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{project=\"brewql\", env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "容器記憶體（working set）",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "targets": [
        {
          "expr": "sum by (service) (container_memory_working_set_bytes{project=\"brewql\", env=\"$env\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
